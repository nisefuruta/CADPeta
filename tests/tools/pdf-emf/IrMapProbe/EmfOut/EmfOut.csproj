<Project Sdk="Microsoft.NET.Sdk">

  <!-- 出力アダプタ層の予行: EMF（GDI P/Invoke）への依存はここ（外側）だけに置き、
       IrModel（内核）へは ProjectReference の一方向で依存する（設計書§1.1）。
       IrModel 側にこのプロジェクトへの参照を作ってはならない。 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- IrImage の PNG デコード用（MIT、Windows のみ）。検証ツール限定 -->
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IrModel\IrModel.csproj" />
  </ItemGroup>

</Project>
