<Project Sdk="Microsoft.NET.Sdk">

  <!-- ARES Standard 2024 での .NET プラグイン読込可否を確認する最小プローブ。
       本体 BIN の managed DLL を compile 専用参照する（実行時はホストが提供する）。
       製品コードではない（検証ハーネス）。ソリューション（CadPeta.sln）へは加えない。 -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- ARES 本体のインストール先。環境が変わる場合はプロパティで上書きする -->
    <AresBinDir>C:\Program Files\Graebert GmbH\ARES Standard 2024\BIN</AresBinDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Teigha.Runtime / DatabaseServices / Geometry / Colors -->
    <Reference Include="TD_Mgd_23.1_16">
      <HintPath>$(AresBinDir)\TD_Mgd_23.1_16.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Teigha.ApplicationServices / EditorInput（Application・Document・Editor・SelectionSet） -->
    <Reference Include="FxCoreMgd_23.1_16">
      <HintPath>$(AresBinDir)\FxCoreMgd_23.1_16.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
