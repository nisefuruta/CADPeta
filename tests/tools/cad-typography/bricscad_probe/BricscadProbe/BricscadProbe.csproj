<Project Sdk="Microsoft.NET.Sdk">

  <!-- BricsCAD V26 ja_JP での .NET プラグイン読込可否を確認する最小プローブ。
       本体 BIN の managed DLL を compile 専用参照する（実行時はホストが提供する）。
       製品コードではない（検証ハーネス）。ソリューション（CadPeta.sln）へは加えない。 -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- BricsCAD 本体のインストール先。環境が変わる場合はプロパティで上書きする -->
    <BricscadBinDir Condition="'$(BricscadBinDir)' == ''">C:\Program Files\Bricsys\BricsCAD V26 ja_JP</BricscadBinDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Teigha.Runtime / DatabaseServices / Geometry / Colors -->
    <Reference Include="TD_Mgd">
      <HintPath>$(BricscadBinDir)\TD_Mgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Bricscad.ApplicationServices / EditorInput（Application・Document・Editor・SelectionSet） -->
    <Reference Include="BrxMgd">
      <HintPath>$(BricscadBinDir)\BrxMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
