<Project Sdk="Microsoft.NET.Sdk">

  <!-- 取得アダプタ（PDF印刷経路: PDFプロット経由、設計書§4）。PdfPig への依存はここ（外側）
       だけに置き、内側（UseCases→Core）へは一方向参照のみ（設計書§1.1）。 -->
  <PropertyGroup>
    <!-- プラグインはホスト AutoCAD のランタイムで読み込まれるため3系マルチターゲット
         （割当ての根拠は src/Directory.Build.props）。本製品は Windows 専用（要求仕様書§4.1）。
         内核・ユースケース層は netstandard2.0（中立）のまま -->
    <TargetFrameworks>$(CadPetaHostTfms)</TargetFrameworks>
    <!-- SMask 合成のピクセル走査（LockBits）用 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- PdfPig: Apache-2.0（Phase 0 で本実装採用を確定、要求仕様書§8）。net48 では net471 資産が
         解決され、追加依存 Microsoft.Bcl.HashCode / System.Memory（いずれも MIT）が入る -->
    <PackageReference Include="PdfPig" Version="$(PdfPigVersion)" />
  </ItemGroup>

  <!-- System.Drawing は JPEG(DCT) デコードと SMask 合成に使う。Windows 限定の制約は実害なし
       （2026-07-07 承認。アダプタ層限定、内核には入れない）。
       net48 は in-box の System.Drawing、net8/net10 は System.Drawing.Common（MIT）で賄う -->
  <ItemGroup Condition="'$(TargetFramework)' == '$(CadPetaNet48Tfm)'">
    <Reference Include="System.Drawing" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != '$(CadPetaNet48Tfm)'">
    <PackageReference Include="System.Drawing.Common" Version="$(SystemDrawingCommonVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- GDI のフォント名解決（GdiFontMetrics）を共有する。PostScript 名からファミリ名を
         求める処理は構造SVG書き出し側と同じ機構であり、複製しない -->
    <ProjectReference Include="..\CadPeta.Acquire.Common\CadPeta.Acquire.Common.csproj" />
    <ProjectReference Include="..\CadPeta.UseCases\CadPeta.UseCases.csproj" />
  </ItemGroup>

</Project>
