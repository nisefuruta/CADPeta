<Project Sdk="Microsoft.NET.Sdk">

  <!-- 取得アダプタ（互換CAD第二対象 IJCAD: DB直接取得）: モデル空間の選択オブジェクトを
       図面データベースから直接読み、出所メタデータ（data-*）付きの SVG IR へ写像する。
       IJCAD 参照はプラグイン合成ルートと本プロジェクトだけに置く
       （tests/ArchitectureTests が機械検査する）。 -->

  <PropertyGroup>
    <!-- IJCAD 2026 PRO の managed API は net8（.NETCoreApp v8.0）のため net8 単一ターゲット -->
    <TargetFramework>$(CadPetaNet8Tfm)</TargetFramework>
    <!-- IJCAD 本体のインストール先。環境が変わる場合はプロパティで上書きする -->
    <IjcadBinDir Condition="'$(IjcadBinDir)' == ''">C:\Program Files\ITJP\IJCAD 2026 PRO</IjcadBinDir>
    <!-- GcDbMgd/GcCoreMgd/GcMgd は NuGet 参照アセンブリではなく実体 DLL（HintPath 直接参照）
         のため、実行時に依存する Microsoft.VisualBasic/System.Drawing/WindowsBase の埋め込み
         版数（8.0.0.0）が net8.0-windows 参照アセンブリの互換版数（4.0.0.0/10.0.0.0）と
         食い違い、MSB3277（解決できない競合）警告になる（2026-07-11 実機確認）。
         いずれもコンパイル専用参照（Private=false、実行時はホスト IJCAD が提供）で実害が
         ないため、この既知の警告だけを抑制する（MSB3277 は Csc の NoWarn ではなく
         ResolveAssemblyReferences 等の MSBuild タスク警告のため MSBuildWarningsAsMessages で
         抑制する） -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
    <DefineConstants>$(DefineConstants);CADPETA_IJCAD</DefineConstants>
  </PropertyGroup>

  <!-- 4製品同文の取得本体は CadCommon の共有ソース（#if 分岐＋using エイリアスで SDK 差を
       吸収）。製品固有の API 差は本プロジェクト直下の LinetypeShapeUprightCompat.cs が持つ -->
  <ItemGroup>
    <Compile Include="..\CadPeta.Acquire.CadCommon\CadIrAcquirer.cs" Link="CadCommon\CadIrAcquirer.cs" />
    <Compile Include="..\CadPeta.Acquire.CadCommon\CadTextMapper.cs" Link="CadCommon\CadTextMapper.cs" />
  </ItemGroup>

  <!-- IJCAD 参照アセンブリ: 利用者所有の本体 DLL への直接参照であり、ビルドには IJCAD の
       インストールが前提となる（NuGet 配布の参照アセンブリを持たないため）。
       Itjp.Ijcad.DatabaseServices/Geometry/Colors/Runtime は GcDbMgd.dll、
       Itjp.Ijcad.EditorInput.Editor・Runtime.CommandMethodAttribute/CommandClassAttribute・
       ApplicationServices.Core.Application（GetSystemVariable・DocumentManager）は
       GcCoreMgd.dll、GUI 側の ApplicationServices.Application は GcMgd.dll。
       Private=false でコンパイル専用参照とし、実行時はホスト IJCAD が同名アセンブリを提供する -->
  <ItemGroup>
    <Reference Include="GcDbMgd">
      <HintPath>$(IjcadBinDir)\GcDbMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GcCoreMgd">
      <HintPath>$(IjcadBinDir)\GcCoreMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GcMgd">
      <HintPath>$(IjcadBinDir)\GcMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CadPeta.Core\CadPeta.Core.csproj" />
    <ProjectReference Include="..\CadPeta.UseCases\CadPeta.UseCases.csproj" />
    <!-- SHX 文字の輪郭化（グリフ輪郭ポートの SHX 実装。既定の写像方式） -->
    <ProjectReference Include="..\CadPeta.Glyphs.Shx\CadPeta.Glyphs.Shx.csproj" />
    <!-- CAD API に依存しない共有計算（曲線近似・線種の端部整列・線種記号の角度解決・
         既定値・GDIフォントメトリクス）。AutoCAD/ARES/IJCAD 構造SVG書き出しアダプタと共有する -->
    <ProjectReference Include="..\CadPeta.Acquire.Common\CadPeta.Acquire.Common.csproj" />
    <ProjectReference Include="..\CadPeta.Acquire.Raster\CadPeta.Acquire.Raster.csproj" />
  </ItemGroup>

</Project>
