<Project Sdk="Microsoft.NET.Sdk">

  <!-- 内核（ドメイン層）: SVG IR モデル・IR 変換層・純幾何（設計書§1.1）。
       外部パッケージ参照ゼロを物理的に維持する。PackageReference も他プロジェクトへの
       ProjectReference も、このプロジェクトに追加してはならない
       （tests/CadPeta.Tests の参照方向テストが機械検査する）。 -->

  <PropertyGroup>
    <!-- 3系（net48 / net8 / net10、src/Directory.Build.props）すべてから参照可能な中立ターゲット -->
    <TargetFramework>$(CadPetaKernelTfm)</TargetFramework>
  </PropertyGroup>

</Project>
