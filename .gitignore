# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Visual Studio / VS Code
.vs/
.vscode/
*.suo
*.user

# JetBrains
.idea/

# Claude Code のマシン固有ローカル設定。承認済みコマンド許可や絶対パスを含み、
# 共有すると各チェックアウトが破壊的コマンドの無確認実行を継承してしまうため除外する。
.claude/settings.local.json

# エディタ一時ファイル
*~
*.swp
*.swo
*.bak

# Python (uv)
.venv/
__pycache__/

# .NET
bin/
obj/

# 配布物の組立途中と zip（再現は dist/build_dist.ps1）。committed はテンプレートと
# スクリプトのみ（dist/bundle・dist/compat・dist/cli・dist/build_dist.ps1）
dist/staging/
dist/artifacts/

# 互換CAD（ARES/IJCAD/BricsCAD）の参照アセンブリ退避キャッシュと転送用パッケージ。
# 本体が無くてもビルドできるよう置く任意のローカルコピー。ベンダーSDK はライセンス下に
# あり、公開リポ（GitHub）へは絶対に含めない（抽出は dist/extract_vendor_refs.ps1）
lib/vendor-refs/
lib/CADPeta-vendor-refs.zip

# Java（PdfBoxProbe。jar の取得手順は phase0/tools/PdfBoxProbe/README.md）
phase0/tools/PdfBoxProbe/lib/
phase0/tools/PdfBoxProbe/out/

# 実物図面コーパス（顧客由来のためリポジトリに含めない。諸元は検証記録に記載する）
phase0/realworld/

# 不具合再現用の実物図面と、そこから出た成果物。顧客由来のため公開リポへ含めない。
samples/
# 実物図面から派生した IR SVG・レンダ・差分画像も同じ理由で含めない
# （再現手順は phase0/検証記録_実物図面.md §8）
phase0/irmap_out/realworld/

# EMF接続検証の出力（実物図面由来の EMF・レンダを含むため全体を除外。
# テストチャート分も再現可能。再現手順は phase0/検証記録_EMF接続.md §10）
phase0/emf_out/

# IR写像検証の再現可能なレンダ出力（再現手順は phase0/検証記録_IR写像.md §8）
phase0/irmap_out/*_150.png
phase0/irmap_out/diff_off/cell_*.png
phase0/irmap_out/diff_console/cell_*.png

# AutoCAD 作業ファイル（accoreconsole のログ・ロックファイル等）
*.log
*.dwl
*.dwl2
*.err

# PETA/PETADIAG がテストチャートへ出力する成果物（再現可能。基準は検証記録側）
# 出力名は <図面>_<レイアウト>_yyyyMMdd_HHmmss.{svg,emf}、診断は .svg.diag.json と .stageNN.<段>.svg。
# 旧パターン *_PETA_* / *_PETADIAG_* は実際の出力名に一致せず無効だったため実命名へ是正した。
# （基本はテストDWGを repo 外＝%TEMP%\CadPeta\verify\ で実行する。これは万一の repo 内実行への防御）
phase0/testchart/*_[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]_*.svg
phase0/testchart/*_[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]_*.emf
phase0/testchart/*.svg.diag.json
phase0/testchart/*.stage*.svg
.pytest_cache/
# 開発用のリポジトリだけで管理するファイル(dist/public-exclude.txt)
CLAUDE.md
AGENTS.md
tasks/
.claude/
docs/code-health-reviews/
dist/publish_public.ps1
tests/tools/distribution/check_publish_public.ps1
tests/CadPeta.Tests/Distribution/PublishPublicTests.cs
dist/public-exclude.txt
